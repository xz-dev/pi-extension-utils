{
  "name": "pi-extension-utils",
  "version": "1.1.0",
  "type": "module",
  "description": "Shared process transport, Pi inquiry, semantic-hook, and strict XML utilities for Pi extensions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz-dev/pi-extension-utils.git"
  },
  "homepage": "https://github.com/xz-dev/pi-extension-utils#readme",
  "bugs": {
    "url": "https://github.com/xz-dev/pi-extension-utils/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./process-domain": {
      "types": "./dist/process-domain/index.d.ts",
      "import": "./dist/process-domain/index.js"
    },
    "./xml": {
      "types": "./dist/xml.d.ts",
      "import": "./dist/xml.js"
    },
    "./pi-inquiry": {
      "types": "./dist/pi-inquiry.d.ts",
      "import": "./dist/pi-inquiry.js"
    },
    "./pi-agent-state": {
      "types": "./dist/pi-agent-state.d.ts",
      "import": "./dist/pi-agent-state.js"
    },
    "./semantic-hook": {
      "types": "./dist/semantic-hook.d.ts",
      "import": "./dist/semantic-hook.js"
    },
    "./preempt-takeover": {
      "types": "./dist/preempt-takeover.d.ts",
      "import": "./dist/preempt-takeover.js"
    },
    "./package.json": "./package.json",
    "./private-inquiry": {
      "types": "./dist/private-inquiry.d.ts",
      "import": "./dist/private-inquiry.js"
    }
  },
  "files": [
    "dist",
    "scripts/prepare-private-runtime.mjs",
    "patches",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:dist": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:acceptance": "node test/run-acceptance.mjs && node test/semantic-hook-packed-e2e.mjs && node test/private-inquiry-packed-e2e.mjs",
    "test:acceptance:bun": "bun test/run-acceptance.mjs",
    "test:acceptance:deno": "deno run --allow-all test/run-acceptance.mjs",
    "check": "npm run typecheck && npm run lint && npm run build:dist && npm run test:unit && npm run test:core && npm run test:acceptance",
    "postinstall": "node scripts/prepare-private-runtime.mjs",
    "prepack": "node scripts/prepare-private-runtime.mjs",
    "test:core": "node --import tsx --test --test-concurrency=1 test/private-inquiry-core.node-test.ts test/private-inquiry-evidence.node-test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.23.13",
    "typebox": "1.3.7",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "private-inquiry-subagents-runtime": "git+https://github.com/nicobailon/pi-subagents.git#1008e5993e90fcf13b815c97c15a0c54f7f6f116"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
